# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── TypeScript build output ───────────────────────────────────────────────────
out/
dist/

# ── VS Code extension packaging ───────────────────────────────────────────────
*.vsix

# ── Input / Output content (keep folders, ignore content) ────────────────────
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# ── Bob / IDE tool files ──────────────────────────────────────────────────────
AGENTS.md
.bob/mcp.json
.playwright-mcp/

# ── Folders starting with underscore ─────────────────────────────────────────
_*/

# ── Binary / compiled artefacts ──────────────────────────────────────────────
*.onnx
*.onnx.data
*.so
*.tgz
*.tar.gz
*.zip
*.dylib

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Coverage / test artefacts ─────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Python (if any tooling scripts use Python) ────────────────────────────────
__pycache__/
*.py[cod]
.venv/
